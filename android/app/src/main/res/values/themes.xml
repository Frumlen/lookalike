<resources>
    <style name="Theme.Lookalike" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>

    <!-- Главное действие: градиент, крупный текст, заметно издалека -->
    <style name="Btn.Primary" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Второстепенное: контур, без заливки -->
    <style name="Btn.Ghost" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/btn_ghost</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Btn.Danger" parent="Btn.Ghost">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>
</resources>
